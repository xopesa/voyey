{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voyey-local",
  "account_id": "00000000000000000000000000000000",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/media/*", "/telegram/*", "/health"]
  },
  "alias": {
    "argon2": "./src/password-disabled.ts"
  },
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voyey-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PREVIEW_ONLY": "1",
    "COMMERCE_ENABLED": "0",
    "VOYEY_LOCAL_ONLY": "1",
    "PUBLIC_ORIGIN": "https://store.voyey.example.invalid",
    "ADMIN_ORIGIN": "https://admin.voyey.example.invalid",
    "ADMIN_AUTH_MODE": "password",
    "ADMIN_ACCESS_EMAILS": "admin@example.invalid"
  }
}
