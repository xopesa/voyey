{
  "name": "stenzo-cloudflare-free",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/worker-local.mjs dev",
    "build": "node scripts/build.mjs",
    "lint": "pnpm lint:config && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:config && turbo run test --concurrency=1",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @stenzo/database db:generate",
    "db:migrate": "pnpm --filter @stenzo/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @stenzo/database db:migrate:deploy",
    "db:seed": "pnpm --filter @stenzo/database db:seed",
    "admin:password": "node scripts/blocked-remote.mjs",
    "config:check": "node scripts/check-preview.mjs",
    "test:config": "node --test scripts/voyey-isolation.test.mjs",
    "deploy": "node scripts/blocked-remote.mjs",
    "lint:config": "eslint scripts/check-preview.mjs scripts/worker-local.mjs scripts/blocked-remote.mjs scripts/voyey-isolation.test.mjs scripts/register-preview-webhook.mjs scripts/set-preview-admin-password.mjs scripts/validate-telegram.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1"
  }
}
