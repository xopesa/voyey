# VOYEY future configuration inventory. NOT a runnable env file at stage 1.1.
# Do not copy old .env/.dev.vars. The local guard currently rejects runtime files.
# Real infrastructure/secrets require a separately approved setup stage.
PREVIEW_ONLY=1
COMMERCE_ENABLED=0
VOYEY_LOCAL_ONLY=1
PUBLIC_ORIGIN=https://store.voyey.example.invalid
ADMIN_ORIGIN=https://admin.voyey.example.invalid
ADMIN_AUTH_MODE=password
ADMIN_PANEL_LOGIN=voyey_admin
ADMIN_PANEL_PASSWORD_HASH=
# Optional future VOYEY Access team; leave disabled.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
ADMIN_ACCESS_EMAILS=admin@example.invalid
JWT_SECRET=
ADMIN_PROXY_SECRET=
# JWT issuer=voyey-api; audience=voyey-miniapp. Generate NEW independent secrets.
# Telegram remains disabled: a separate bot, channel and webhook are not created.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHANNEL_ID=
TELEGRAM_SALES_USERNAME=
ADMIN_TELEGRAM_IDS=
MANUAL_PAYMENT_CARD_HOLDER=
MANUAL_PAYMENT_CARD_NUMBER=
MANUAL_PAYMENT_INSTRUCTIONS_RU=
MANUAL_PAYMENT_INSTRUCTIONS_UZ=
# D1 uses the DB binding with an inactive local UUID, never DATABASE_URL.
# Media remains in D1. Future optional R2: two NEW separate public/private buckets;
# no R2 binding or credentials are enabled at this stage.
