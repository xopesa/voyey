# Independent Workers target only. For local development, copy this template to
# apps/worker/.dev.vars and fill only new preview values. Never commit that file.
# Wrangler vars default to PREVIEW_ONLY=1 and COMMERCE_ENABLED=0.
# Catalog/static preview needs only the D1 binding and local migrations.
PUBLIC_ORIGIN=https://preview.example.invalid
ADMIN_ORIGIN=https://admin-preview.example.invalid
ACCESS_TEAM_DOMAIN=https://replace-team.cloudflareaccess.com
ACCESS_AUD=
ADMIN_ACCESS_EMAILS=admin@example.invalid
JWT_SECRET=
ADMIN_PROXY_SECRET=
# Optional full commerce: use a separate test bot and preview payment details.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_IDS=
MANUAL_PAYMENT_CARD_HOLDER=
MANUAL_PAYMENT_CARD_NUMBER=
MANUAL_PAYMENT_INSTRUCTIONS_RU=
MANUAL_PAYMENT_INSTRUCTIONS_UZ=
# D1 credentials are bindings in Wrangler config, never DATABASE_URL.
