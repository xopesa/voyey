generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum Currency {
  UZS
}

enum OrderStatus {
  AWAITING_PREPAYMENT
  PREPAYMENT_SUBMITTED
  AWAITING_PURCHASE
  PURCHASED
  IN_TRANSIT
  ARRIVED
  WEIGHING
  AWAITING_FINAL_PAYMENT
  FINAL_PAYMENT_SUBMITTED
  PAID_FULL
  READY_TO_SHIP
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentType {
  PREPAYMENT
  FINAL
}

enum PaymentStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum PreferredLocale {
  uz
  ru
}

enum TelegramProductPostStatus {
  PENDING
  PUBLISHED
  FAILED
}

model TelegramProductPost {
  id String @id @default(cuid())
  productId String
  channelChatId String
  messageId Int?
  status TelegramProductPostStatus @default(PENDING)
  attemptId String
  publishedAt DateTime?
  lastAttemptAt DateTime
  lastErrorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@unique([productId, channelChatId])
}

model User {
  id              String          @id @default(cuid())
  telegramId      BigInt          @unique
  username        String?
  firstName       String?
  lastName        String?
  languageCode    String?
  preferredLocale PreferredLocale @default(uz)
  status          UserStatus      @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  auditLogs        AuditLog[] @relation("AuditLogActor")
  cart             Cart?
  customerNotes    CustomerNote[]
  orders           Order[]
  promoRedemptions PromoCodeRedemption[]
  reviewedPayments Payment[]  @relation("PaymentReviewer")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Category {
  requiresBuyerMeasurements Boolean @default(true)
  attributeDefinitions Json @default("[]")
  archivedAt DateTime?
  archivedBy String?
  banners Banner[]
  id        String   @id @default(cuid())
  nameRu    String
  nameUz    String
  slug      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([isActive, sortOrder])
}

model Product {
  attributes Json @default("{}")
  archivedAt DateTime?
  archivedBy String?
  banners Banner[]
  id            String        @id @default(cuid())
  categoryId    String
  nameRu        String
  nameUz        String
  slug          String        @unique
  descriptionRu String?
  descriptionUz String?
  sourceUrl     String?
  costPrice     Int?
  salePrice     Int?
  saleStartsAt  DateTime?
  saleEndsAt    DateTime?
  price         Int
  currency      Currency      @default(UZS)
  status        ProductStatus @default(DRAFT)
  isFeatured    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category   Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  telegramPosts TelegramProductPost[]
  variants   ProductVariant[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([categoryId, status])
  @@index([status, isFeatured])
  @@index([status, createdAt, id])
}

enum BannerTarget {
  NONE
  CATALOG
  CATEGORY
  PRODUCT
  URL
}

model Banner {
  id String @id @default(cuid())
  titleRu String
  titleUz String
  subtitleRu String?
  subtitleUz String?
  buttonRu String?
  buttonUz String?
  imageUrl String @default("")
  storageKey String?
  targetType BannerTarget @default(NONE)
  targetCategoryId String?
  targetProductId String?
  targetUrl String?
  sortOrder Int @default(0)
  isActive Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  targetCategory Category? @relation(fields: [targetCategoryId], references: [id], onDelete: SetNull)
  targetProduct Product? @relation(fields: [targetProductId], references: [id], onDelete: SetNull)
  @@index([isActive, sortOrder])
  @@index([updatedAt])
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  url        String
  storageKey String?  @unique
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, sortOrder])
  @@index([productId, isPrimary])
}

model ProductVariant {
  attributes Json @default("{}")
  id        String   @id @default(cuid())
  productId String
  sku       String   @unique
  // Empty string is the backward-compatible representation of no size.
  size      String
  color     String?
  stock     Int?
  // Independent catalog permission. Does not change stock=NULL or enable checkout.
  preorderEnabled Boolean @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId, isActive])
  @@index([productId, size])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  saleMode String @default("LEGACY")
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String
  quantity  Int
  heightCm  Int?
  weightKg  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId, saleMode])
  @@index([productId])
  @@index([variantId])
}

enum ExpenseCategory {
  CARGO
  PACKAGING
  DELIVERY
  ADVERTISING
  BANK_FEE
  OTHER
}
enum CancellationReason {
  CUSTOMER_REQUEST
  OUT_OF_STOCK
  SUPPLIER_UNAVAILABLE
  DUPLICATE_ORDER
  PAYMENT_ISSUE
  OTHER
}
enum StockReleaseStatus {
  NOT_RELEASED
  RELEASED
  REVIEW_REQUIRED
}
enum RefundStatus {
  PENDING
  COMPLETED
}
model Refund {
  id String @id @default(cuid())
  orderId String @unique
  amount Int
  status RefundStatus @default(PENDING)
  reference String?
  note String?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?
  completedBy String?
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([status, createdAt, id])
  @@index([completedAt])
}
model CustomerRefundNotificationDelivery {
  id String @id @default(cuid())
  eventKey String
  telegramId String
  eventType String
  status TelegramDeliveryStatus @default(PENDING)
  attemptId String
  telegramMessageId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sentAt DateTime?
  lastErrorCode String?
  @@unique([eventKey, telegramId])
}
model Expense {
  id String @id @default(cuid())
  category ExpenseCategory
  amount Int
  occurredAt DateTime
  description String?
  orderId String?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  voidedAt DateTime?
  voidedBy String?
  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([occurredAt, id])
  @@index([category, occurredAt, id])
  @@index([orderId])
}

enum OrderSource {
  MINIAPP
  ADMIN
}

model CustomerNote {
  id String @id @default(cuid())
  userId String
  body String
  createdBy String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt, id])
}

model Order {
  cancelledAt DateTime?
  cancelledBy String?
  cancellationReason CancellationReason?
  cancellationNote String?
  stockReleaseStatus StockReleaseStatus @default(NOT_RELEASED)
  stockReleasedAt DateTime?
  refund Refund?
  completedAt DateTime?
  dashboardHiddenAt DateTime?
  estimatedWarehouseArrival String?
  expenses Expense[]
  source OrderSource @default(MINIAPP)
  id                 String      @id @default(cuid())
  publicId           String      @unique
  userId             String
  idempotencyKey     String
  status             OrderStatus @default(AWAITING_PREPAYMENT)
  fullName           String
  phone              String
  city               String
  address            String
  apartment          String?
  comment            String?
  currency           Currency    @default(UZS)
  // Canonical pre-promo subtotal. NULL on legacy orders; subtotal keeps the 0001 compatibility CHECK.
  itemsSubtotal      Int?
  discountAmount     Int @default(0)
  promoCodeSnapshot  String?
  promoRedemption    PromoCodeRedemption?
  subtotal           Int
  total              Int
  requiredPrepayment Int
  paidAmount         Int         @default(0)
  remainingAmount    Int
  cargoAmount        Int?
  cargoPaidAmount    Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt, id])
  @@index([status, createdAt, id])
  @@index([completedAt, id])
  @@index([dashboardHiddenAt, createdAt, id])
}

model OrderItem {
  catalogSnapshot Json?
  inventoryReservedQuantity Int?
  procurementUnitCost Int?
  procurementUpdatedAt DateTime?
  procurementUpdatedBy String?
  id            String   @id @default(cuid())
  orderId       String
  productId     String?
  variantId     String?
  productNameRu String
  productNameUz String
  productSlug   String
  imageUrl      String?
  sku           String
  size          String
  color         String?
  originalUnitPrice Int?
  unitPrice     Int
  quantity      Int
  lineTotal     Int
  heightCm      Int?
  weightKg      Int?
  createdAt     DateTime @default(now())

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Payment {
  id               String        @id @default(cuid())
  orderId          String
  type             PaymentType
  status           PaymentStatus @default(SUBMITTED)
  expectedAmount   Int
  idempotencyKey   String
  proofStorageKey  String        @unique
  proofMimeType    String
  reviewedByUserId String?
  rejectionReason  String?
  submittedAt      DateTime      @default(now())
  reviewedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("PaymentReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([orderId, idempotencyKey])
  @@index([orderId, submittedAt])
  @@index([status, type, submittedAt])
}

// Infrastructure only; customer commerce domain models remain unchanged.
model AdminWebSession {
  tokenHash String @id
  csrfToken String
  expiresAt DateTime
  @@index([expiresAt])
}

model AdminLoginRateLimit {
  key String @id
  count Int
  expiresAt DateTime
  @@index([expiresAt])
}

model TelegramAdmin {
  id String @id @default(cuid())
  telegramId String @unique
  label String?
  isActive Boolean @default(true)
  notifyNewOrders Boolean @default(true)
  notifyPayments Boolean @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TelegramDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model TelegramNotificationDelivery {
  id String @id @default(cuid())
  eventKey String
  telegramId String
  eventType String
  status TelegramDeliveryStatus @default(PENDING)
  attemptId String
  telegramMessageId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sentAt DateTime?
  lastErrorCode String?
  @@unique([eventKey, telegramId])
}

enum PromoCodeType {
  PERCENT
  FIXED
}
model PromoCode {
  engineVersion Int @default(1)
  id String @id @default(cuid())
  code String @unique
  type PromoCodeType
  value Int
  minOrderAmount Int?
  maxDiscount Int?
  startsAt DateTime?
  endsAt DateTime?
  usageLimit Int?
  perUserLimit Int @default(1)
  isActive Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  redemptions PromoCodeRedemption[]
}
model PromoCodeRedemption {
  releasedAt DateTime?
  releaseReason String?
  id String @id @default(cuid())
  promoCodeId String
  userId String
  orderId String @unique
  discountAmount Int
  createdAt DateTime @default(now())
  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([promoCodeId])
  @@index([userId])
  @@index([createdAt])
}

// Isolated linked-order contracts. Foreign keys and immutable quarantine are enforced by D1 0021.
model CheckoutGroup {
 id String @id
 selectedSaleMode String?
 userId String
 idempotencyKey String
 requestFingerprint String
 recipient Json
 goodsSubtotal Int
 discountAmount Int
 goodsTotal Int
 sealed Boolean @default(false)
 createdAt DateTime
 @@unique([userId,idempotencyKey])
 @@unique([id,userId])
}
model CheckoutOrder {
 id String @id
 publicId String @unique
 checkoutGroupId String
 saleMode String
 state String @default("PAYMENTS_BLOCKED")
 financialPolicy Json
 goodsSubtotal Int
 discountAmount Int
 goodsTotal Int
 prepaymentPercent Int
 firstPaymentAmount Int
 remainingAfterFirst Int
 goodsPaid Int @default(0)
 unpaidGoods Int
 cargoAmount Int?
 cargoPaid Int @default(0)
 createdAt DateTime
 @@unique([checkoutGroupId,saleMode])
 @@unique([id,saleMode])
}
model CheckoutOrderItem {
 id String @id
 orderId String
 saleMode String
 cartItemId String
 productId String
 variantId String
 quantity Int
 unitPrice Int
 lineTotal Int
 inventoryReservedQuantity Int
 snapshot Json
 createdAt DateTime
 @@unique([orderId,variantId])
}
model CheckoutPromoUse {
 id String @id
 checkoutGroupId String @unique
 userId String
 promoCodeId String
 discountAmount Int
 releasedAt DateTime?
 createdAt DateTime
}

// 0022 SQL owns constraints/FKs. CheckoutOrder remains the immutable initial contract.
model CheckoutPayment {
 invoiceId String?
 id String @id
 orderId String
 phase String @default("FIRST")
 source String
 submittedBy String
 attachedBy String
 submitKey String
 submitFingerprint String
 declaredAmount Int
 expectedAmount Int
 confirmedAmount Int @default(0)
 proofStorageKey String @unique
 proofMimeType String
 proofSize Int
 proofSha256 String
 status String @default("SUBMITTED")
 submittedAt DateTime
 reviewedBy String?
 reviewedAt DateTime?
 reviewKey String?
 reviewFingerprint String?
 rejectionReason String?
 @@unique([id,orderId])
 @@unique([submittedBy,submitKey])
 @@unique([reviewedBy,reviewKey])
 @@index([orderId,submittedAt,id])
}
model CheckoutPaymentLedger {
 invoiceId String?
 id String @id
 paymentId String @unique
 orderId String
 phase String
 kind String
 goodsAmount Int
 cargoAmount Int @default(0)
 bankOperationDigest String @unique
 verifiedBy String
 verifiedAt DateTime
 reviewKey String
 reviewFingerprint String
 @@unique([orderId,phase])
}

// 0023 owns FK/state invariants; these are immutable owner-confirmed snapshots.
model CheckoutArrival {
 id String @id
 orderId String @unique
 arrivedAt DateTime
 itemSnapshot Json
 createdBy String
 createdAt DateTime
 operationKey String
 requestFingerprint String
 @@unique([id,orderId])
 @@unique([createdBy,operationKey])
}
model CheckoutCargoCharge {
 id String @id
 orderId String @unique
 arrivalId String @unique
 version Int
 amount Int
 createdBy String
 createdAt DateTime
 operationKey String
 requestFingerprint String
 @@unique([id,orderId])
 @@unique([createdBy,operationKey])
}
model CheckoutFinalInvoice {
 id String @id
 orderId String @unique
 arrivalId String
 cargoChargeId String @unique
 firstLedgerId String @unique
 version Int
 currency String
 goodsTotal Int
 firstGoodsPaid Int
 goodsDue Int
 cargoDue Int
 totalDue Int
 createdBy String
 createdAt DateTime
 operationKey String
 requestFingerprint String
 @@unique([id,orderId])
 @@unique([createdBy,operationKey])
}

// 0024: immutable cancellation + exactly-once release; original orders stay unchanged.
model CheckoutCancellation {
 id String @id
 orderId String @unique
 reason String
 createdBy String
 createdAt DateTime
 operationKey String
 requestFingerprint String
 financialSnapshot Json
 reservationSnapshot Json
 sealed Boolean @default(false)
 @@unique([id,orderId])
 @@unique([createdBy,operationKey])
}
model CheckoutStockRelease {
 id String @id
 cancellationId String
 orderId String
 itemId String @unique
 variantId String
 quantity Int
 stockBefore Int
 stockAfter Int
 createdAt DateTime
 @@index([orderId])
}

// 0025: full refund requests/allocations, outgoing ledger and independent stock reconciliation.
model CheckoutRefund {
 id String @id
 orderId String @unique
 reason String
 createdBy String
 createdAt DateTime
 operationKey String
 requestFingerprint String
 goodsAmount Int
 cargoAmount Int
 totalAmount Int
 financialSnapshot Json
 sealed Boolean @default(false)
 @@unique([id,orderId])
 @@unique([createdBy,operationKey])
}
model CheckoutRefundAllocation {
 id String @id
 refundId String
 orderId String
 paymentLedgerId String @unique
 goodsAmount Int
 cargoAmount Int
 @@index([refundId])
}
model CheckoutRefundLedger {
 id String @id
 refundId String @unique
 orderId String @unique
 goodsAmount Int
 cargoAmount Int
 totalAmount Int
 currency String
 confirmedBy String
 confirmedAt DateTime
 bankOperationDigest String @unique
 operationKey String
 requestFingerprint String
 bankTransferVerified Boolean
 @@unique([id,refundId,orderId])
 @@unique([confirmedBy,operationKey])
}
model CheckoutRefundStockReconciliation {
 id String @id
 refundId String @unique
 orderId String @unique
 refundLedgerId String @unique
 createdBy String
 createdAt DateTime
 operationKey String
 requestFingerprint String
 sealed Boolean @default(false)
 @@unique([id,refundId,orderId])
 @@unique([createdBy,operationKey])
}
model CheckoutRefundStockRelease {
 id String @id
 reconciliationId String
 refundId String
 orderId String
 itemId String @unique
 variantId String
 quantity Int
 stockBefore Int
 stockAfter Int
 createdAt DateTime
 @@index([orderId])
}

// 0026: compatible settings for existing PromoCode identity, no new usage lifecycle.
model PromoCampaign {
 id String @id
 campaignKey String @unique
 name String
 createdBy String
 createdAt DateTime
}
model PromoCodePolicy {
 promoCodeId String @id
 saleModes String
 audience String
 purpose String
 personalUserId String?
 campaignId String?
 scope String
 createdBy String
 createdAt DateTime
 sealed Boolean @default(false)
}
model PromoPolicyCategory {
 promoCodeId String
 categoryId String
 @@id([promoCodeId,categoryId])
}
model PromoPolicyProduct {
 promoCodeId String
 productId String
 @@id([promoCodeId,productId])
}
model PromoPolicyExclusion {
 promoCodeId String
 productId String
 saleModes String
 @@id([promoCodeId,productId,saleModes])
}
